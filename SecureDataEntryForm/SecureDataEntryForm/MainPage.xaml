<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="SecureDataEntryForm.MainPage">

    <ScrollView>
       <VerticalStackLayout Padding="20,20"
                            Spacing="20">

           <!-- Title -->
           <Label Text="Secure Data Entry Form"
                  FontSize="24"
                  FontAttributes="Bold"
                  HorizontalTextAlignment="Center"/>

           <Label Text="Enter your information in the masked fields below"
                  FontSize="14"
                  HorizontalTextAlignment="Center"/>

           <!-- Credit Card Section -->
           <Frame BorderColor="#E0E0E0"
                  CornerRadius="10"
                  Padding="15"
                  HasShadow="True">
               <VerticalStackLayout Spacing="15">
                   <Label Text="Credit Card Information"
                          FontSize="16"
                          FontAttributes="Bold"/>

                   <!-- Credit Card Number -->
                   <VerticalStackLayout Spacing="5">
                       <Label Text="Card Number (16 digits)"
                              FontSize="12"/>
                       <editors:SfMaskedEntry x:Name="CardNumberEntry"
                                              Mask="0000 0000 0000 0000"
                                              MaskType="Simple"
                                              Placeholder="0000 0000 0000 0000"
                                              TextColor="#333333"
                                              Stroke="#CCCCCC"/>
                   </VerticalStackLayout>

                   <!-- Cardholder Name -->
                   <VerticalStackLayout Spacing="5">
                       <Label Text="Cardholder Name"
                              FontSize="12"/>
                       <Entry x:Name="CardholderEntry"
                              Placeholder="John Doe"
                              TextColor="#333333"
                              BackgroundColor="#FFFFFF"/>
                   </VerticalStackLayout>

                   <!-- Expiry Date -->
                   <HorizontalStackLayout Spacing="15">
                       <VerticalStackLayout Spacing="5" 
                                            FlexLayout.Basis="50%">
                           <Label Text="Expiry Date (MM/YY)"
                                  FontSize="12"/>
                           <editors:SfMaskedEntry x:Name="ExpiryEntry"
                                                  Mask="00/00"
                                                  MaskType="Simple"
                                                  Placeholder="MM/YY"
                                                  TextColor="#333333"
                                                  WidthRequest="60"/>
                       </VerticalStackLayout>

                       <!-- CVV -->
                       <VerticalStackLayout Spacing="5" 
                                            FlexLayout.Basis="50%">
                           <Label Text="CVV (3 digits)"
                                  FontSize="12"/>
                           <editors:SfMaskedEntry x:Name="CVVEntry"
                                                  Mask="000"
                                                  MaskType="Simple"
                                                  Placeholder="000"
                                                  TextColor="#333333"
                                                  PasswordChar="*"
                                                  WidthRequest="40"/>
                       </VerticalStackLayout>
                   </HorizontalStackLayout>
               </VerticalStackLayout>
           </Frame>

           <!-- Contact Information Section -->
           <Frame BorderColor="#E0E0E0"
                  CornerRadius="10"
                  Padding="15"
                  HasShadow="True">
               <VerticalStackLayout Spacing="15">
                   <Label Text="Contact Information"
                          FontSize="16"
                          FontAttributes="Bold"/>

                   <!-- Phone Number -->
                   <VerticalStackLayout Spacing="5">
                       <Label Text="Phone Number"
                              FontSize="12"/>
                       <editors:SfMaskedEntry x:Name="PhoneEntry"
                                              Mask="(000) 000-0000"
                                              MaskType="Simple"
                                              Placeholder="(000) 000-0000"
                                              TextColor="#333333"
                                              Stroke="#CCCCCC"/>
                   </VerticalStackLayout>

                   <!-- Email -->
                   <VerticalStackLayout Spacing="5">
                       <Label Text="Email Address"
                              FontSize="12"/>
                       <Entry x:Name="EmailEntry"
                              Placeholder="user@example.com"
                              Keyboard="Email"
                              TextColor="#333333"
                              BackgroundColor="#FFFFFF"/>
                   </VerticalStackLayout>
               </VerticalStackLayout>
           </Frame>

           <!-- Identification Section -->
           <Frame BorderColor="#E0E0E0"
                  CornerRadius="10"
                  Padding="15"
                  HasShadow="True">
               <VerticalStackLayout Spacing="15">
                   <Label Text="Identification"
                          FontSize="16"
                          FontAttributes="Bold"/>

                   <!-- SSN -->
                   <VerticalStackLayout Spacing="5">
                       <Label Text="Social Security Number (SSN)"
                              FontSize="12"/>
                       <editors:SfMaskedEntry x:Name="SSNEntry"
                                              Mask="000-00-0000"
                                              MaskType="Simple"
                                              Placeholder="000-00-0000"
                                              PasswordChar="*"
                                              TextColor="#333333"/>
                   </VerticalStackLayout>

                   <!-- ZIP Code -->
                   <VerticalStackLayout Spacing="5">
                       <Label Text="ZIP Code"
                              FontSize="12"/>
                       <editors:SfMaskedEntry x:Name="ZIPEntry"
                                              Mask="00000"
                                              MaskType="Simple"
                                              Placeholder="00000"
                                              TextColor="#333333"/>
                   </VerticalStackLayout>
               </VerticalStackLayout>
           </Frame>

           <!-- Buttons -->
           <HorizontalStackLayout Spacing="10" 
                                  Margin="0,10">
               <Button x:Name="SubmitButton"
                       Text="Submit"
                       BackgroundColor="#512BD4"
                       TextColor="White"
                       FontAttributes="Bold"
                       Padding="15"
                       CornerRadius="5"
                       FlexLayout.Basis="50%"
                       Clicked="OnSubmitClicked"/>

               <Button x:Name="ClearButton"
                       Text="Clear"
                       BackgroundColor="#999999"
                       TextColor="White"
                       FontAttributes="Bold"
                       Padding="15"
                       CornerRadius="5"
                       FlexLayout.Basis="50%"
                       Clicked="OnClearClicked"/>
           </HorizontalStackLayout>

           <!-- Status Message -->
           <Label x:Name="StatusLabel"
                  Text=""
                  FontSize="12"
                  TextColor="#4CAF50"
                  HorizontalTextAlignment="Center"
                  Margin="0,10"/>

       </VerticalStackLayout>
   </ScrollView> 

</ContentPage>
